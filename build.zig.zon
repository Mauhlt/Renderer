.{
    .name = .Renderer,
    .version = "0.0.0",
    .fingerprint = 0x8efc3ca5a6851ba,
    .minimum_zig_version = "0.18.0-dev.1005+75d48dfff",
    // Pinned commits on GitHub. Build against local checkouts with
    // `zig build --fork=../Vulkan ...`. Image pins the same Vulkan commit, so a
    // program using Image and Renderer gets one shared "Vulkan" module.
    .dependencies = .{
        .Vulkan = .{
            .url = "git+https://github.com/Mauhlt/Vulkan#61aaf9f6ae0114b22ce42f72822991d549dcc055",
            .hash = "Vulkan-0.1.0-9v7hoTYlAAAp50c3Eqxe-uaBkVPkgcgpB_5I1fWewcVs",
        },
        .Windows = .{
            .url = "git+https://github.com/Mauhlt/Windows#29e94252aed079b3e5b1502a04c42dae15ce9bd9",
            .hash = "Windows-0.0.0-F1HWObO0AwDpr1kFX_O1s_zP9vYzTY7v8Rop7yX3LX_Z",
        },
        // Window module backends (src/Window): Wayland on Linux, AppKit on macOS.
        .Wayland = .{
            .url = "git+https://github.com/Mauhlt/Wayland#4aa975f443ba59d5989cb62bb23a0f8cb8e202fd",
            .hash = "Wayland-0.0.0-Sp1drpdSAQAkRXnMMtw44T1zDT4p30NrYyP_1Mi7l6mb",
        },
        .MacOS = .{
            .url = "git+https://github.com/Mauhlt/MacOS#fc552c480e9ecfa0b4576481fe817936dc0d4728",
            .hash = "MacOS-0.0.0-AvEoY7S3AACKSOXAWqzb7xFF45GtaYscOv9_sIkT4bi4",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "LICENSE",
        "THIRD_PARTY.md",
    },
}
