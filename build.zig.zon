.{
    .name = .Renderer,
    .version = "0.0.0",
    .fingerprint = 0x8efc3ca5a6851ba,
    .minimum_zig_version = "0.18.0-dev.1005+75d48dfff",
    // Pinned commits on GitHub. Build against local checkouts with
    // `zig build --fork=../Vulkan ...`. Image pins the same Vulkan commit, so a
    // program using Image and Renderer gets one shared "Vulkan" module.
    .dependencies = .{
        .Vulkan = .{
            .url = "git+https://github.com/Mauhlt/Vulkan#b831b1e464db394c2ddb8da11d5dff93f1df4144",
            .hash = "Vulkan-0.1.0-9v7hoY4bAACSpjlULEH56u3k6cYDDZa1hgBgVU-lkUuR",
        },
        .Windows = .{
            .url = "git+https://github.com/Mauhlt/Windows#7fe3899260c18ba3f672ed64aaa1f24e8e5829d7",
            .hash = "Windows-0.0.0-F1HWOUCtAwA8VZdYAi2YoJavXyjb2ZiIiu9s3EmNnt4l",
        },
        // Window module backends (src/Window): Wayland on Linux, AppKit on macOS.
        .Wayland = .{
            .url = "git+https://github.com/Mauhlt/Wayland#bd5b49e1b628d58ede1d93b2dde2e733e52c6537",
            .hash = "Wayland-0.0.0-Sp1dru1HAQBes2CP4TGMh3aIe0xTbNgkT3WgOkTObnkf",
        },
        .MacOS = .{
            .url = "git+https://github.com/Mauhlt/MacOS#4960014dbbda33f54b40f6d32e35b9ec61498574",
            .hash = "MacOS-0.0.0-AvEoY9GwAACyf7BIF8-DI1vAzl_hero7eEXqH9v9Onpy",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "LICENSE",
        "THIRD_PARTY.md",
    },
}
