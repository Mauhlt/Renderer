.{
    .name = .Renderer,
    .version = "0.0.0",
    .fingerprint = 0x8efc3ca5a6851ba,
    .minimum_zig_version = "0.18.0-dev.1005+75d48dfff",
    // Pinned commits on GitHub. Build against local checkouts with
    // `zig build --fork=../Vulkan ...`. Image pins the same Vulkan commit, so a
    // program using Image and Renderer gets one shared "Vulkan" module.
    .dependencies = .{
        .Vulkan = .{
            .url = "git+https://github.com/Mauhlt/Vulkan#61aaf9f6ae0114b22ce42f72822991d549dcc055",
            .hash = "Vulkan-0.1.0-9v7hoTYlAAAp50c3Eqxe-uaBkVPkgcgpB_5I1fWewcVs",
        },
        .Windows = .{
            .url = "git+https://github.com/Mauhlt/Windows#6b5ea5aa517166850b3b93f6bf90c2c21c31bd0b",
            .hash = "Windows-0.0.0-F1HWOf5dBgAaIxdaZF5bd-W-FtOPEgU0tlfbJCTdNC0l",
        },
        // Window module backends (src/Window): Wayland on Linux, AppKit on macOS.
        .Wayland = .{
            .url = "git+https://github.com/Mauhlt/Wayland#8e0740dd1b2884d50febe861564310419a3dec88",
            .hash = "Wayland-0.0.0-Sp1driqDAQCrv4mozkcC_tBzgL23p0fkgLoYlmWgeDKP",
        },
        .MacOS = .{
            .url = "git+https://github.com/Mauhlt/MacOS#e1d93c290429457e532db7fa2ecec7c0411421f0",
            .hash = "MacOS-0.0.1-AvEoY7S3AABQHe6a7pKtzamlfs1nLEECaoX2f8VGa0Cs",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "LICENSE",
        "THIRD_PARTY.md",
    },
}
